# Social backend, Node 24+. Store must not be inside a public/static root.
SOCIAL_DATA_DIR=./social-data
CHAT_PRODUCT_NAME=Esteria
CHAT_SERVER_ID=esteria
CHAT_REALM_ID=1
CHAT_BRIDGE_SECRET=
CHAT_MAX_LINKS=1
CHAT_DIRECT=true
CHAT_FRIENDS=true
CHAT_GROUPS=true
CHAT_ATTACHMENTS=true
CHAT_CHARACTER_PRESENCE=false
CHAT_COLOR_BACKGROUND=#14171c
CHAT_COLOR_PANEL=#1a1e24
CHAT_COLOR_ACCENT=#b88a44
CHAT_COLOR_TEXT=#eef1f5
CHAT_FONT=NotoSans-Regular.ttf
CHAT_MEDIA_FORMATS=png,jpg,gif,webp
CHAT_MEDIA_RETENTION_HOURS=168
CHAT_MEDIA_MAX_UPLOAD_BYTES=10485760
CHAT_MEDIA_MAX_ATTACHMENTS_PER_MESSAGE=4
CHAT_MEDIA_MAX_MESSAGE_UPLOAD_BYTES=20971520
CHAT_MEDIA_CLEANUP_INTERVAL_SECONDS=300
CHAT_MEDIA_ORPHAN_RETENTION_MINUTES=60
CHAT_MEDIA_CACHE_MAX_BYTES=268435456
CHAT_MEDIA_MAX_CONCURRENT_ANIMATIONS=3
CHAT_MEDIA_MAX_DIMENSION=4096
CHAT_MEDIA_MAX_DECODED_PIXELS=16777216
CHAT_MEDIA_MAX_DECODED_FRAME_PIXELS=67108864
CHAT_MEDIA_MAX_FRAMES=120
CHAT_MEDIA_MAX_ANIMATION_DURATION_MS=60000
